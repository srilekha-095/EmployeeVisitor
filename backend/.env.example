PORT=5000
MONGO_DB=mongodb://127.0.0.1:27017/visitor_management

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_LIFETIME=1d

# Staff must enter this code on the signup page to create an EMPLOYEE account.
# Leave it empty to disable employee signup entirely.
EMPLOYEE_SIGNUP_CODE=choose_a_company_access_code

# Comma-separated list of allowed frontend origins (leave empty to allow all)
CLIENT_URL=http://localhost:5173
